### 6.4 Teste de Membros

Crie `cypress/e2e/membros.cy.ts`:

```typescript
describe('Gestão de Membros', () => {

  beforeEach(() => {
    cy.login(Cypress.env('ADMIN_EMAIL'), Cypress.env('ADMIN_PASSWORD'))
    cy.visit('/membros')
  })

  it('exibe a lista de membros', () => {
    cy.get('[data-cy=pageMembros]').should('be.visible')
    cy.get('[data-cy=listaMembrosDesktop]').should('exist')
  })

  it('botão Novo Membro está visível para ADMIN', () => {
    cy.get('[data-cy=btnNovoMembro]').should('be.visible')
  })

  it('navega para o formulário de cadastro', () => {
    cy.get('[data-cy=btnNovoMembro]').click()
    cy.url().should('include', '/membros/novo')
    cy.get('[data-cy=pageNovoMembro]').should('be.visible')
  })

  it('valida campo obrigatório nome', () => {
    cy.visit('/membros/novo')
    cy.get('[data-cy=tabFicha-saude]').click()
    cy.get('[data-cy=btnSalvarMembro]').click()
    cy.get('[data-cy=msgErroNovoMembro]').should('be.visible')
    cy.url().should('include', '/membros/novo')
  })

  it('cadastra um membro com dados básicos', () => {
    const nome = `Membro Teste ${Date.now()}`
    cy.visit('/membros/novo')
    cy.get('[data-cy=inputNomeCompleto]').type(nome)
    cy.get('[data-cy=btnProximo]').click()
    cy.get('[data-cy=btnProximo]').click()
    cy.get('[data-cy=btnProximo]').click()
    cy.get('[data-cy=btnProximo]').click()
    cy.get('[data-cy=btnSalvarMembro]').click()
    cy.url().should('include', '/membros')
    cy.contains(nome).should('be.visible')
  })

  it('busca membro por nome', () => {
    cy.get('[data-cy=inputBuscaMembro]').type('João')
    cy.get('[data-cy^=membroItemDesktop-]').each(($row) => {
      cy.wrap($row).contains('João')
    })
  })

  it('filtra por status', () => {
    cy.get('[data-cy=selectFiltroStatus]').select('Pastor')
    cy.get('[data-cy^=membroItemDesktop-]').each(($row) => {
      cy.wrap($row).contains('Pastor')
    })
  })

  it('abre perfil completo do membro', () => {
    cy.get('[data-cy^=btnVerMembroDesktop-]').first().click()
    cy.get('[data-cy=pagePerfilMembro]').should('be.visible')
  })

})
```

