### 6.5 Teste de CEP

Crie `cypress/e2e/cep.cy.ts`:

```typescript
describe('Busca automática de CEP', () => {

  beforeEach(() => {
    cy.login(Cypress.env('ADMIN_EMAIL'), Cypress.env('ADMIN_PASSWORD'))
    cy.visit('/membros/novo')
    cy.contains('Contato').click() // vai para aba 2
  })

  it('preenche endereço com CEP válido', () => {
    cy.get('input[placeholder="00000-000"]').type('01310100')
    // Aguarda a busca assíncrona
    cy.get('input[placeholder="Nome da rua"]', { timeout: 5000 })
      .should('not.have.value', '')
  })

  it('aplica máscara no CEP', () => {
    cy.get('input[placeholder="00000-000"]').type('01310100')
    cy.get('input[placeholder="00000-000"]').should('have.value', '01310-100')
  })

  it('exibe ✓ após CEP válido preenchido', () => {
    cy.get('input[placeholder="00000-000"]').type('01310100')
    cy.contains('✓').should('be.visible')
  })

})
```

