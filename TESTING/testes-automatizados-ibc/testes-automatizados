### 6.5 Teste de CEP

Crie `cypress/e2e/cep.cy.ts`:

```typescript
describe('Busca automática de CEP', () => {

  beforeEach(() => {
    cy.login(Cypress.env('ADMIN_EMAIL'), Cypress.env('ADMIN_PASSWORD'))
    cy.visit('/membros/novo')
    cy.get('[data-cy=tabFicha-contato]').click()
  })

  it('preenche endereço com CEP válido', () => {
    cy.get('[data-cy=inputCep]').type('01310100')
    cy.get('[data-cy=inputRua]', { timeout: 5000 })
      .should('not.have.value', '')
  })

  it('aplica máscara no CEP', () => {
    cy.get('[data-cy=inputCep]').type('01310100')
    cy.get('[data-cy=inputCep]').should('have.value', '01310-100')
  })

  it('exibe ✓ após CEP válido preenchido', () => {
    cy.get('[data-cy=inputCep]').type('01310100')
    cy.get('[data-cy=iconeCepValido]').should('be.visible')
  })

})
```

