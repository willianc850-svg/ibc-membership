### 6.7 Teste de Permissões

Crie `cypress/e2e/permissoes.cy.ts`:

```typescript
describe('Controle de Permissões', () => {

  it('USER não vê botão Novo membro', () => {
    cy.login(Cypress.env('TEST_EMAIL'), Cypress.env('TEST_PASSWORD'))
    cy.visit('/membros')
    cy.get('[data-cy=btnNovoMembro]').should('not.exist')
  })

  it('USER não vê botão Excluir no perfil', () => {
    cy.login(Cypress.env('TEST_EMAIL'), Cypress.env('TEST_PASSWORD'))
    cy.visit('/membros')
    cy.get('[data-cy^=btnVerMembroDesktop-]').first().click()
    cy.get('[data-cy=btnExcluirMembro]').should('not.exist')
  })

  it('USER não vê seção de usuários em Configurações', () => {
    cy.login(Cypress.env('TEST_EMAIL'), Cypress.env('TEST_PASSWORD'))
    cy.visit('/configuracoes')
    cy.get('[data-cy=btnNovoUsuario]').should('not.exist')
  })

  it('SUPER_ADMIN vê seção de usuários', () => {
    cy.login(Cypress.env('ADMIN_EMAIL'), Cypress.env('ADMIN_PASSWORD'))
    cy.visit('/configuracoes')
    cy.get('[data-cy=btnNovoUsuario]').should('be.visible')
  })

  it('badge de nível de acesso exibe role correto', () => {
    cy.login(Cypress.env('TEST_EMAIL'), Cypress.env('TEST_PASSWORD'))
    cy.visit('/configuracoes')
    cy.get('[data-cy=badgeNivelAcesso]').should('contain', 'Usuário')
  })

})
```

