### 6.3 Teste de Autenticação

Crie `cypress/e2e/auth.cy.ts`:

```typescript
describe('Autenticação', () => {

  it('redireciona para login quando não autenticado', () => {
    cy.visit('/dashboard')
    cy.url().should('include', '/login')
  })

  it('mostra erro com credenciais inválidas', () => {
    cy.visit('/login')
    cy.get('[data-cy=inputEmailLogin]').type('errado@email.com')
    cy.get('[data-cy=inputSenhaLogin]').type('senha-errada')
    cy.get('[data-cy=btnEntrar]').click()
    cy.get('[data-cy=msgErroLogin]').should('be.visible')
  })

  it('faz login com credenciais válidas', () => {
    cy.login()
    cy.url().should('include', '/dashboard')
    cy.contains('Dashboard').should('be.visible')
  })

  it('faz logout corretamente', () => {
    cy.login()
    cy.get('[data-cy=btnSairSidebar]').click()
    cy.url().should('include', '/login')
  })

  it('não acessa dashboard após logout', () => {
    cy.login()
    cy.get('[data-cy=btnSairSidebar]').click()
    cy.visit('/dashboard')
    cy.url().should('include', '/login')
  })

})
```

