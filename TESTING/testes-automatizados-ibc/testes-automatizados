### 6.4 Teste de Membros

Crie `cypress/e2e/membros.cy.ts`:

```typescript
describe('Gestão de Membros', () => {

  beforeEach(() => {
    cy.login(Cypress.env('ADMIN_EMAIL'), Cypress.env('ADMIN_PASSWORD'))
    cy.visit('/membros')
  })

  it('exibe a lista de membros', () => {
    cy.contains('Membros').should('be.visible')
    cy.get('table').should('exist')
  })

  it('botão Novo Membro está visível para ADMIN', () => {
    cy.contains('Novo membro').should('be.visible')
  })

  it('navega para o formulário de cadastro', () => {
    cy.contains('Novo membro').click()
    cy.url().should('include', '/membros/novo')
    cy.contains('Novo Membro').should('be.visible')
  })

  it('valida campo obrigatório nome', () => {
    cy.visit('/membros/novo')
    // Vai direto para a aba 5 e tenta salvar
    cy.contains('Saúde').click()
    cy.contains('Salvar membro').click()
    cy.contains('nome completo é obrigatório').should('be.visible')
    cy.url().should('include', '/membros/novo') // não saiu da página
  })

  it('cadastra um membro com dados básicos', () => {
    const nome = `Membro Teste ${Date.now()}`
    cy.visit('/membros/novo')
    cy.get('input').first().type(nome) // campo nome_completo
    // Navegar até a última aba e salvar
    cy.contains('Próximo').click()
    cy.contains('Próximo').click()
    cy.contains('Próximo').click()
    cy.contains('Próximo').click()
    cy.contains('Salvar membro').click()
    cy.url().should('include', '/membros')
    cy.contains(nome).should('be.visible')
  })

  it('busca membro por nome', () => {
    cy.get('input[placeholder*="Buscar"]').type('João')
    cy.get('table tbody tr').each(($row) => {
      cy.wrap($row).contains('João')
    })
  })

  it('filtra por status', () => {
    cy.get('select').first().select('Pastor')
    cy.get('table tbody tr').each(($row) => {
      cy.wrap($row).contains('Pastor')
    })
  })

  it('abre perfil completo do membro', () => {
    cy.get('table tbody tr').first().contains('Ver').click()
    cy.contains('Informações pessoais').should('be.visible')
    cy.contains('Contato e endereço').should('be.visible')
    cy.contains('Dados eclesiásticos').should('be.visible')
  })

})
```

