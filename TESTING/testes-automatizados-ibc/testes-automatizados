### 6.6 Teste de Reuniões

Crie `cypress/e2e/reunioes.cy.ts`:

```typescript
describe('Módulo de Reuniões', () => {

  beforeEach(() => {
    cy.login()
    cy.visit('/reunioes')
  })

  it('exibe a lista de reuniões', () => {
    cy.contains('Reuniões').should('be.visible')
    cy.contains('Nova reunião').should('be.visible')
  })

  it('filtra por tipo de reunião', () => {
    cy.contains('Diretoria').click()
    // Verifica que todos os cards visíveis são do tipo Diretoria
    cy.get('[class*="reuniao-card"]').each(($card) => {
      cy.wrap($card).contains('Diretoria')
    })
  })

  it('cria uma nova reunião', () => {
    const titulo = `Reunião Teste ${Date.now()}`
    cy.contains('Nova reunião').click()
    cy.url().should('include', '/reunioes/nova')

    cy.get('input[placeholder*="Título"]').type(titulo)
    cy.get('input[type="date"]').type('2025-06-15')
    cy.contains('Criar reunião').click()

    cy.url().should('match', /\/reunioes\/[a-z0-9-]+$/)
    cy.contains(titulo).should('be.visible')
  })

  it('finaliza uma reunião', () => {
    // Assume que existe pelo menos uma reunião em rascunho
    cy.visit('/reunioes')
    cy.contains('Rascunho').first().click()
    cy.contains('Finalizar reunião').click()
    cy.contains('Finalizada').should('be.visible')
  })

})
```

