### 6.6 Teste de Reuniões

Crie `cypress/e2e/reunioes.cy.ts`:

```typescript
describe('Módulo de Reuniões', () => {

  beforeEach(() => {
    cy.login()
    cy.visit('/reunioes')
  })

  it('exibe a lista de reuniões', () => {
    cy.get('[data-cy=pageReunioes]').should('be.visible')
    cy.get('[data-cy=btnNovaReuniao]').should('be.visible')
  })

  it('filtra por tipo de reunião', () => {
    cy.get('[data-cy=btnFiltroTipo-Diretoria]').click()
    cy.get('[data-cy^=linkReuniao-]').each(($card) => {
      cy.wrap($card).contains('Diretoria')
    })
  })

  it('cria uma nova reunião', () => {
    const titulo = `Reunião Teste ${Date.now()}`
    cy.get('[data-cy=btnNovaReuniao]').click()
    cy.url().should('include', '/reunioes/nova')

    cy.get('[data-cy=inputTituloReuniao]').type(titulo)
    cy.get('[data-cy=inputDataReuniao]').type('2025-06-15')
    cy.get('[data-cy=btnCriarReuniao]').click()

    cy.url().should('match', /\/reunioes\/[a-z0-9-]+$/)
    cy.contains(titulo).should('be.visible')
  })

  it('finaliza uma reunião', () => {
    cy.visit('/reunioes')
    cy.get('[data-cy^=linkReuniao-]').first().click()
    cy.get('[data-cy=btnFinalizarReuniao]').click()
    cy.contains('Finalizada').should('be.visible')
  })

})
```

